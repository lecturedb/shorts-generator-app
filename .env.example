# Use an absolute path when overriding the macOS default documented in
# docs/RUNTIME.md. Never place API keys in this committed example file.
SHORTS_PROJECTS_DIR=

# OpenAI 대본·장면 구성(서버 전용, 실제 값은 .env.local에만 입력)
OPENAI_API_KEY=

# 선택 사항: 비워 두면 gpt-5.4-mini를 사용합니다.
OPENAI_SCRIPT_MODEL=

# fal.ai 생성 서비스(서버 전용, 실제 키와 모델 ID는 .env.local에만 입력)
FAL_AI_API_KEY=
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=
FAL_VOICE_MODEL=
FAL_MUSIC_MODEL=
